# /etc/parfi-backup.env — configuration de la sauvegarde MySQL offsite.
#
# Installation :
#   sudo cp parfi-backup.env.example /etc/parfi-backup.env
#   sudo chown root:root /etc/parfi-backup.env
#   sudo chmod 600 /etc/parfi-backup.env
#   (puis remplir les valeurs ci-dessous)
#
# Cette configuration active la copie hors machine des sauvegardes MySQL.
# Sans ce fichier, backup-mysql.sh ne fait que du dump local et se comporte
# exactement comme aujourd'hui.

# ── Hook offsite : chemin absolu du script d'envoi ─────────────────────────
OFFSITE_HOOK=/opt/parfi-crm/scripts/offsite-upload.sh

# ── Chiffrement client (age) ───────────────────────────────────────────────
# Chemin d'un fichier ne contenant QUE la ligne de clé publique age
# ("age1..."), en lecture pour tous (chmod 644 root).
# La clé privée correspondante NE DOIT PAS être sur ce serveur.
AGE_RECIPIENT_FILE=/etc/parfi-backup-age.pub

# ── Stockage objet S3-compatible (Scaleway ou OVH) ─────────────────────────
# Scaleway : https://s3.fr-par.scw.cloud    (region : fr-par | nl-ams | pl-waw)
# OVH      : https://s3.gra.io.cloud.ovh.net (region : gra | sbg | rbx | de | uk | bhs | waw)
S3_ENDPOINT=https://s3.fr-par.scw.cloud
S3_BUCKET=parfi-backups
S3_PREFIX=
AWS_DEFAULT_REGION=fr-par

# ── Identifiants (clé API restreinte en écriture seule) ────────────────────
# Créer une clé API avec un policy limitée à s3:PutObject sur $S3_BUCKET.
# Pas de DeleteObject, pas de PutObjectRetention — la rétention est portée
# par le cycle de vie du bucket.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# ── Notifications ──────────────────────────────────────────────────────────
# Adresse à laquelle envoyer les erreurs (utilisée par cron via MAILTO).
# La ligne MAILTO dans /etc/cron.d/parfi-backup-mysql est le vecteur principal.
MAILTO_ERROR=root
