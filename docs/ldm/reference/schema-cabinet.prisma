// =============================================================================
// MODULE CABINET - Configuration Parfi France
// =============================================================================
// Centralise les données du cabinet utilisées dans les snapshots LDM.
// Une seule ligne en base pour Parfi France, mais le modèle est dimensionné
// pour supporter une éventuelle multi-cabinets (Parfi Group multi-sites).
// =============================================================================

model Cabinet {
  id                              String      @id @default(cuid())
  estParDefaut                    Boolean     @default(false) // un seul peut être par défaut

  // --- Identification juridique ---
  denomination                    String      // "Parfi France"
  formeJuridique                  String      // "SAS"
  capitalSocial                   Decimal?    @db.Decimal(15, 2)
  siren                           String      @unique
  numeroTVA                       String?
  rcs                             String      // "RCS Briey"
  codeAPE                         String?     // "6920Z"

  // --- Coordonnées ---
  adresse                         String      @db.Text
  codePostal                      String
  ville                           String
  pays                            String      @default("France")
  telephone                       String
  email                           String

  // --- Inscription ordinale ---
  numeroInscriptionOEC            String?     // numéro Ordre des Experts-Comptables
  conseilRegionalOEC              String      @default("Grand Est")

  // --- Responsabilité civile professionnelle ---
  rcProfessionnelle               Json        // { compagnie, numeroPolice, montantGarantie, dateRenouvellement }

  // --- Tribunal compétent ---
  tribunalCompetent               String      // "Tribunal de commerce de Briey"

  // --- Sous-traitants RGPD (déclarés dans les LDM) ---
  // Format JSON pour rester souple : liste de { denomination, siren, adresse, role, localisationServeurs, paysHebergement }
  sousTraitantsRGPD               Json

  // --- Outils de production utilisés ---
  // Liste des outils mentionnés en CG art. 5 (CG-05-OUTILS)
  outilsProduction                Json        // [{ nom, editeur, usage }]

  // --- Audit ---
  creeLe                          DateTime    @default(now())
  modifieLe                       DateTime    @updatedAt
  modifieParId                    String?
  modifiePar                      User?       @relation("CabinetModificateur", fields: [modifieParId], references: [id])

  @@index([estParDefaut])
}

