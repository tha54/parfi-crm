# Dependencies
node_modules/

# Build output
frontend/dist/

# Environment (couvre .env, .env.local, .env.production, .env.bak.*, etc.)
.env
.env.*
!.env.example
!.env.sample

# Logs
*.log
npm-debug.log*

# OS
.DS_Store
Thumbs.db

# Editor
.vscode/
.idea/

# PM2
.pm2/

# Exports CSV ad hoc (ex. export_dossiers_*.csv à la racine)
# Les CSV de données de référence versionnés (docs-production/seed/) sont
# exclus par des exceptions explicites plus bas.
/*.csv

# Données de référence versionnées (lots production/supervision) :
# les 6 fichiers seed sont indispensables au fonctionnement des migrations.
!docs-production/seed/*.csv

# Fichiers générés (uploads)
backend/uploads/devis/*.pdf
backend/uploads/ldm/*.pdf
backend/uploads/factures/*.pdf
backend/uploads/lettres/*.pdf

# Python bytecode
backend/src/python/__pycache__/
*.pyc
*.pyo
